# Webserver
PORT=8080

# Postgres
# Beispiel Render/Cloud: postgres://USER:PASS@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# Azure Document Intelligence
AZURE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com
AZURE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_API_VERSION=2024-02-29-preview

# Pipeline-Einstellungen
# Schwellwert, ab dem wir bei "invoice" nicht mehr auf "receipt" / "layout" / "read" zurückfallen
MODEL_CONFIDENCE_THRESHOLD=0.80

# Standard-Kontenrahmen (wird gespeichert, kann später überschrieben werden)
DEFAULT_CHART_OF_ACCOUNTS=SKR03
