# Server
PORT=8787

# Azure Document Intelligence (v4.0 GA 2024-11-30)
# REST-Route (v4.0): 
#   POST {endpoint}/documentintelligence/documentModels/{modelId}:analyze
#   ?_overload=analyzeDocument&api-version=2024-11-30
# Body: { base64Source: "<...>" } ODER { urlSource: "<...>" }
AZURE_DI_ENDPOINT=https://<deine-ressource>.cognitiveservices.azure.com
AZURE_DI_KEY=<dein-key>
AZURE_DI_API_VERSION=2024-11-30

# Feature Toggles / Early-Exit
# Reihenfolge: invoice, receipt, layout, read
DI_MODEL_ORDER=invoice,receipt,layout,read
DI_THRESHOLD_INVOICE=0.80
DI_THRESHOLD_RECEIPT=0.80
DI_THRESHOLD_LAYOUT=0.65
DI_THRESHOLD_READ=0.00
